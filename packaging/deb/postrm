#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "restroos: your data stays in Docker volumes (restroos_pg_data, restroos_uploads_data, restroos_state) and your settings and generated passwords in /etc/restroos/restroos.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name restroos down -v ; sudo rm -rf /etc/restroos" >&2
fi
exit 0
