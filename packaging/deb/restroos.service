[Unit]
Description=RestroOS (Docker Compose)
Documentation=https://github.com/bookingbotdhd/restaurant-posdocs
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
ExecStart=/usr/bin/docker compose --project-name restroos --env-file /etc/restroos/restroos.env -f /usr/lib/restroos/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --project-name restroos --env-file /etc/restroos/restroos.env -f /usr/lib/restroos/docker-compose.yml down

[Install]
WantedBy=multi-user.target
