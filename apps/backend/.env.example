DATABASE_URL="postgresql://shibam:restroos_dev_pw@localhost:5432/restroos"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
PORT=4001
CORS_ORIGIN="http://localhost:1995"

# Sign-up (POST /auth/register) is first-run setup only: once the server has a
# restaurant it is closed. Set true ONLY if you deliberately host several
# restaurants and accept that each new owner gets instance-level permissions
# (backup, update, sync) - see SECURITY.md.
# ALLOW_PUBLIC_SIGNUP=false

# Encrypts third-party integration credentials at rest (AES-256-GCM). 16+ chars.
# If unset it is derived from JWT_SECRET, so rotating JWT_SECRET would orphan
# saved credentials - set a dedicated key in production and back it up.
# INTEGRATION_SECRET_KEY=
# INTEGRATION_SECRET_KEY_FILE=/run/secrets/integration_key   # alternative: read the key from a file
# PUBLIC_BASE_URL=https://pos.example.com   # payment return page + webhook base

# WhatsApp bill (one bill at a time, staff opt-in — see docs/WHATSAPP-BILL.md).
# Default "noop" sends nothing; set WHATSAPP_BILL_PROVIDER=meta-cloud plus the
# Meta credentials below to go live (Meta developer app + phone number +
# approved utility template — the account belongs to the restaurant).
# WHATSAPP_BILL_PROVIDER=noop   # noop | meta-cloud | twilio ("twilio" is a
#   reserved name for a future provider implementation — setting it alone
#   does nothing until that provider is built and registered)
# WHATSAPP_BILL_TEMPLATE_NAME=   # approved Meta utility template name (provider "meta-cloud" needs one)
# WHATSAPP_BILL_TEMPLATE_LANGUAGE=en   # template language code
# Meta WhatsApp Business Cloud API (provider "meta-cloud"):
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=   # optional, not needed for sending
# WHATSAPP_API_TOKEN=
# WHATSAPP_API_VERSION=v21.0   # pinned Graph API version — confirm the current one in Meta's docs at setup time
# WHATSAPP_APP_SECRET=   # Meta app secret — verifies status-webhook signatures
# WHATSAPP_VERIFY_TOKEN=   # token Meta must present when verifying the webhook URL
# Twilio (provider "twilio", when implemented):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
