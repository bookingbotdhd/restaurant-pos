DATABASE_URL="postgresql://shibam:restroos_dev_pw@localhost:5432/restroos"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
PORT=4001
CORS_ORIGIN="http://localhost:1995"

# Sign-up (POST /auth/register) is first-run setup only: once the server has a
# restaurant it is closed. Set true ONLY if you deliberately host several
# restaurants and accept that each new owner gets instance-level permissions
# (backup, update, sync) - see SECURITY.md.
# ALLOW_PUBLIC_SIGNUP=false

# Encrypts third-party integration credentials at rest (AES-256-GCM). 16+ chars.
# If unset it is derived from JWT_SECRET, so rotating JWT_SECRET would orphan
# saved credentials - set a dedicated key in production and back it up.
# INTEGRATION_SECRET_KEY=
# INTEGRATION_SECRET_KEY_FILE=/run/secrets/integration_key   # alternative: read the key from a file
# PUBLIC_BASE_URL=https://pos.example.com   # payment return page + webhook base

# Zomato / Swiggy / aggregator inbound webhooks — environment fallback only.
# Prefer Settings -> Integrations in the UI (per-restaurant, encrypted, with
# enable/disable and an activity log). These variables are only used when a
# restaurant has NO saved connection for that provider, and a saved-but-
# disabled connection is never re-enabled by them. Leave them commented out
# unless this install is configured by deployment config instead of the UI.
# Generate each secret with e.g. `openssl rand -hex 24` (16+ characters) and
# paste the SAME value into the aggregator / merchant webhook settings.
# AGGREGATOR_WEBHOOKS_ENABLED=true   # set false to refuse all aggregator webhooks
# AGGREGATOR_ZOMATO_ENABLED=true
# AGGREGATOR_ZOMATO_WEBHOOK_SECRET=
# AGGREGATOR_SWIGGY_ENABLED=true
# AGGREGATOR_SWIGGY_WEBHOOK_SECRET=
# AGGREGATOR_AGGREGATOR_ENABLED=true
# AGGREGATOR_AGGREGATOR_WEBHOOK_SECRET=
